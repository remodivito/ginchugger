# Copy to .env to enable live model review. Never include real keys in a submission.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional compatible endpoint. Sent documents go to the configured provider.
OPENAI_BASE_URL=https://api.openai.com/v1
PORT=3000
# Optional: sign exported review records (Ed25519). 64 hex characters, e.g. from `openssl rand -hex 32`. Keep it out of any submission.
REVIEW_RECORD_SIGNING_KEY=
